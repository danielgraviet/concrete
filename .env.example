OPENROUTER_API_KEY=
# Optional. Without these, Claude Code and Codex use your CLI subscription login.
ANTHROPIC_API_KEY=
CODEX_API_KEY=

# Web version (Firebase). Leave empty for the desktop app. See src/backend/cloud/README.md.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# "true" to use local emulators (firebase emulators:start) instead of the real project.
VITE_FIREBASE_USE_EMULATOR=
